node_modules/
dist/
.env
.agentlings/
*.log
.DS_Store
Thumbs.db
.claude/settings.local.json

# A saved browser session is a bearer token for every site in it.
browser-state*.json

# Source images dropped in by hand. A file in this repository makes its
# licence this project's problem (LEVELPACK.md), and a drop folder fills up
# with things nobody re-read the terms of. Inputs stay out; an installed pack
# under web/public/packs/ is the tracked output, and carries its provenance.
Artwork/*
!Artwork/README.md

# pack:render output — the crew's eyes (D-112), drawn beside the pack it
# reads. A render is a measurement, not part of the installed world.
web/public/packs/*/pack.png
web/public/packs/*/PACK.png

# The bare template is regenerable (build_template.py, one command), and a
# DRESSED one may carry assets whose licence forbids redistributing the
# .blend itself (BlenderKit — see art/blender/README.md). Whether a dressed
# template gets tracked is decided at dressing time (D-148 amendment).
art/blender/*.blend
art/blender/*.blend1
