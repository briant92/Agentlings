# Copy to .env (gitignored). Any ONE of these enables the real executor:
#
# 1. An Anthropic API key:
ANTHROPIC_API_KEY=
#
# 2. A long-lived Claude Code token — run `claude setup-token` in any
#    terminal and paste the result here:
# CLAUDE_CODE_OAUTH_TOKEN=
#
# 3. Nothing: a fresh `claude` login on this machine is auto-detected
#    (if its stored token is stale, jobs fail with a 401 — use 1 or 2).

# Force an executor regardless of detection: claude | simulated
# AGENTLINGS_EXECUTOR=simulated

# Optional, read-only. The library reads public repos unauthenticated
# (60 requests/hour, enough for a handful of sources); a token raises that
# to 5000/hour. Sent to api.github.com only, never to raw file hosts.
# GITHUB_TOKEN=
